{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter spur-bot-frontend build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/chat/message",
      "destination": "/api/chat/message"
    },
    {
      "source": "/chat/session/:sessionId",
      "destination": "/api/chat/session/:sessionId"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

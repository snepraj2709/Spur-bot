{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build -w frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/chat/message",
      "destination": "/api/chat/message"
    },
    {
      "source": "/chat/session/:sessionId",
      "destination": "/api/chat/session/:sessionId"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
